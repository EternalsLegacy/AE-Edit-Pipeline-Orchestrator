<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Native-Inspired Dark Desktop Surfaces -->
    <Color x:Key="SurfaceBase">#13151A</Color>
    <Color x:Key="SurfaceCard">#1A1D23</Color>
    <Color x:Key="SurfaceElevated">#22262F</Color>
    <Color x:Key="SurfaceHover">#2A303B</Color>
    <Color x:Key="BorderSubtle">#2A2F3B</Color>
    <Color x:Key="BorderStrong">#3A4152</Color>

    <!-- Primary Accent -->
    <Color x:Key="AccentPrimary">#5B65E6</Color>
    <Color x:Key="AccentHover">#7079EE</Color>
    <Color x:Key="AccentPressed">#4B54CC</Color>
    <Color x:Key="AccentSubtleBg">#1E2133</Color>
    <Color x:Key="AccentSubtleBorder">#353B63</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="StatusSuccess">#22C55E</Color>
    <Color x:Key="StatusSuccessBg">#16261E</Color>
    <Color x:Key="StatusSuccessBorder">#244734</Color>

    <Color x:Key="StatusWarning">#EAB308</Color>
    <Color x:Key="StatusWarningBg">#262013</Color>
    <Color x:Key="StatusWarningBorder">#4D3D1A</Color>

    <Color x:Key="StatusError">#EF4444</Color>
    <Color x:Key="StatusErrorBg">#291619</Color>
    <Color x:Key="StatusErrorBorder">#54262C</Color>

    <Color x:Key="StatusNeutral">#717D92</Color>
    <Color x:Key="StatusNeutralBg">#1E222B</Color>
    <Color x:Key="StatusNeutralBorder">#2E3442</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimary">#ECEFF4</Color>
    <Color x:Key="TextSecondary">#9AA4B6</Color>
    <Color x:Key="TextMuted">#6B7588</Color>

    <!-- MAUI Template Compatibility Aliases -->
    <Color x:Key="Primary">#5B65E6</Color>
    <Color x:Key="PrimaryDark">#5B65E6</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#22262F</Color>
    <Color x:Key="SecondaryDarkText">#7079EE</Color>
    <Color x:Key="Tertiary">#4B54CC</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#13151A</Color>

    <Color x:Key="Gray100">#ECEFF4</Color>
    <Color x:Key="Gray200">#CBD5E1</Color>
    <Color x:Key="Gray300">#9AA4B6</Color>
    <Color x:Key="Gray400">#6B7588</Color>
    <Color x:Key="Gray500">#475569</Color>
    <Color x:Key="Gray600">#334155</Color>
    <Color x:Key="Gray900">#1A1D23</Color>
    <Color x:Key="Gray950">#13151A</Color>

    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBase}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
