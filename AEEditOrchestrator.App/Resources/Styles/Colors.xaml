<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Dark-First Desktop Surface Hierarchy -->
    <Color x:Key="SurfaceBase">#111318</Color>
    <Color x:Key="SurfaceCard">#1A1D24</Color>
    <Color x:Key="SurfaceElevated">#222733</Color>
    <Color x:Key="SurfaceHover">#2A303E</Color>
    <Color x:Key="BorderSubtle">#2D3342</Color>
    <Color x:Key="BorderStrong">#3E475C</Color>

    <!-- Accent (Indigo / Violet) -->
    <Color x:Key="AccentPrimary">#6366F1</Color>
    <Color x:Key="AccentHover">#818CF8</Color>
    <Color x:Key="AccentPressed">#4F46E5</Color>
    <Color x:Key="AccentSubtleBg">#1E213D</Color>
    <Color x:Key="AccentSubtleBorder">#3D427A</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="StatusSuccess">#22C55E</Color>
    <Color x:Key="StatusSuccessBg">#132A1E</Color>
    <Color x:Key="StatusSuccessBorder">#1F4D36</Color>

    <Color x:Key="StatusWarning">#F59E0B</Color>
    <Color x:Key="StatusWarningBg">#2A2010</Color>
    <Color x:Key="StatusWarningBorder">#5A4016</Color>

    <Color x:Key="StatusError">#EF4444</Color>
    <Color x:Key="StatusErrorBg">#2B1418</Color>
    <Color x:Key="StatusErrorBorder">#5C2229</Color>

    <Color x:Key="StatusNeutral">#64748B</Color>
    <Color x:Key="StatusNeutralBg">#1E232E</Color>
    <Color x:Key="StatusNeutralBorder">#333B4D</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>

    <!-- MAUI Template Compatibility Aliases -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#6366F1</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#222733</Color>
    <Color x:Key="SecondaryDarkText">#818CF8</Color>
    <Color x:Key="Tertiary">#4F46E5</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#111318</Color>

    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#CBD5E1</Color>
    <Color x:Key="Gray300">#94A3B8</Color>
    <Color x:Key="Gray400">#64748B</Color>
    <Color x:Key="Gray500">#475569</Color>
    <Color x:Key="Gray600">#334155</Color>
    <Color x:Key="Gray900">#1A1D24</Color>
    <Color x:Key="Gray950">#111318</Color>

    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBase}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
