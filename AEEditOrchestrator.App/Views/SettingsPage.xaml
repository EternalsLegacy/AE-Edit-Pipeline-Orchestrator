<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AEEditOrchestrator.App.ViewModels"
             x:Name="SettingsRootPage"
             x:Class="AEEditOrchestrator.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <Grid RowDefinitions="*, Auto"
          Padding="14"
          RowSpacing="10">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="12" Padding="0,0,6,0">

                <!-- Header -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="Einstellungen"
                           Style="{StaticResource PageTitleLabelStyle}" />
                    <Label Text="Pfade, Stabilität, geschützte Layer, Preset-Mapping und Effekt-Parameter"
                           Style="{StaticResource MutedCaptionLabelStyle}" />
                </VerticalStackLayout>

                <!-- Card 1: Pfade & Stabilität -->
                <Border Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="PFADE &amp; STABILITÄT"
                               Style="{StaticResource SectionHeaderLabelStyle}" />

                        <!-- AfterFX.exe -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="AfterFX.exe Pfad"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       Text="{Binding AfterEffectsExecutablePath, Mode=TwoWay}"
                                       Placeholder="C:\Program Files\Adobe\Adobe After Effects 2026\Support Files\AfterFX.exe" />
                                <Button Grid.Column="1"
                                        Text="Auto-Erkennen"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DetectAfterEffectsPathCommand}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- User Presets Folder -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="User Presets Ordner"
                                   Style="{StaticResource FieldLabelStyle}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0"
                                       Text="{Binding UserPresetsRootPath, Mode=TwoWay}"
                                       Placeholder="Dokumente\Adobe\After Effects 2026\User Presets" />
                                <Button Grid.Column="1"
                                        Text="Auto-Erkennen"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding DetectUserPresetsPathCommand}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Numeric Stability Params -->
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Batch-Größe (Clips)"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding BatchSizeText, Mode=TwoWay}"
                                       Keyboard="Numeric" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Watchdog-Timeout (s)"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding WatchdogTimeoutSecondsText, Mode=TwoWay}"
                                       Keyboard="Numeric" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="Max. Backups"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding MaxBackupsToKeepText, Mode=TwoWay}"
                                       Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Toggles -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Switch IsToggled="{Binding SaveAfterBatch, Mode=TwoWay}" />
                                <Label Text="SaveAfterBatch (Nach Batch speichern)"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Switch IsToggled="{Binding PurgeAfterBatch, Mode=TwoWay}" />
                                <Label Text="PurgeAfterBatch (RAM-Cache leeren)"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Card 2: Geschützte Layer -->
                <Border Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="GESCHÜTZTE LAYER &amp; AUSWAHL"
                               Style="{StaticResource SectionHeaderLabelStyle}" />

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Switch IsToggled="{Binding UseSelectedOnly, Mode=TwoWay}" />
                            <Label Text="Nur markierte Clips verarbeiten"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Ausgeschlossene Layer-Namen (case-insensitiv geschützt)"
                               Style="{StaticResource FieldLabelStyle}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExcludedLayerNames}"
                                             Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border BackgroundColor="{StaticResource SurfaceElevated}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="10,4">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding .}"
                                                   VerticalOptions="Center" />
                                            <Button Grid.Column="1"
                                                    Text="Entfernen"
                                                    Style="{StaticResource CompactDangerButtonStyle}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=RemoveExcludedLayerCommand, x:DataType=vm:SettingsViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Text="{Binding NewExcludedLayerName, Mode=TwoWay}"
                                   Placeholder="Layer-Name eingeben (z. B. Watermark)..." />
                            <Button Grid.Column="1"
                                    Text="Hinzufügen"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding AddExcludedLayerCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Card 3: Presets & Effekt-Parameter -->
                <Border Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="PRESETS &amp; EFFEKT-PARAMETER"
                                   Style="{StaticResource SectionHeaderLabelStyle}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Presets jetzt validieren"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding ValidatePresetsCommand}" />
                        </Grid>

                        <!-- 7 Preset Names -->
                        <Grid ColumnDefinitions="*, *, *"
                              RowDefinitions="Auto, Auto, Auto"
                              ColumnSpacing="10"
                              RowSpacing="8">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="FadeInOut Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding FadeInOutPresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="VerticalShake Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding VerticalShakePresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="3">
                                <Label Text="VerticalBlur Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding VerticalBlurPresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="HorizontalShake Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding HorizontalShakePresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="HorizontalBlur Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding HorizontalBlurPresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="3">
                                <Label Text="BlurZoomIn Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding BlurZoomInPresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="3">
                                <Label Text="BlurZoomOut Preset" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding BlurZoomOutPresetName, Mode=TwoWay}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Preset Validation Results -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PresetValidationItems}"
                                             Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetValidationItemViewModel">
                                    <Border BackgroundColor="{StaticResource SurfaceElevated}"
                                            Stroke="{StaticResource BorderSubtle}"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,5">
                                        <Grid ColumnDefinitions="140, Auto, *" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding PresetName}"
                                                   FontFamily="OpenSansSemibold"
                                                   VerticalOptions="Center" />

                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="7,2"
                                                    VerticalOptions="Center"
                                                    BackgroundColor="{StaticResource StatusErrorBg}"
                                                    Stroke="{StaticResource StatusErrorBorder}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsFound}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource StatusSuccessBg}" />
                                                        <Setter Property="Stroke" Value="{StaticResource StatusSuccessBorder}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="{StaticResource StatusError}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsFound}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>

                                            <Label Grid.Column="2"
                                                   Text="{Binding PathDisplayText}"
                                                   Style="{StaticResource MutedCaptionLabelStyle}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Effect Parameters -->
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,4" />

                        <Grid ColumnDefinitions="*, *, *, *"
                              RowDefinitions="Auto, Auto"
                              ColumnSpacing="10"
                              RowSpacing="8">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                <Label Text="Motion Tile Width" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding MotionTileWidthText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                <Label Text="Motion Tile Height" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding MotionTileHeightText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="3">
                                <Label Text="StartBlur Frames" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding StartBlurFramesText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="0" Grid.Column="3" Spacing="3">
                                <Label Text="StartDirection Stage 1" Style="{StaticResource FieldLabelStyle}" />
                                <Picker ItemsSource="{Binding StartDirectionOptions}"
                                        SelectedItem="{Binding SelectedStartDirectionOption, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                <Label Text="EndBlur 1 Länge" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding EndBlur1LengthText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="EndBlur 2 Länge" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding EndBlur2LengthText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="3">
                                <Label Text="Vertical Blur Winkel (°)" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding VerticalBlurDirectionText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="3" Spacing="3">
                                <Label Text="Horizontal Blur Winkel (°)" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding HorizontalBlurDirectionText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="BlurZoom Start Stage 2" Style="{StaticResource FieldLabelStyle}" />
                                <Picker ItemsSource="{Binding BlurZoomStartOptions}"
                                        SelectedItem="{Binding SelectedBlurZoomStartOption, Mode=TwoWay}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="End" Padding="0,0,0,4">
                                <Switch IsToggled="{Binding AddMotionTileToBlurZoom, Mode=TwoWay}" />
                                <Label Text="Motion Tile auf BlurZoom-Layer hinzufügen"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Beat Detection Params -->
                        <BoxView HeightRequest="1" Color="{StaticResource BorderSubtle}" Margin="0,4" />
                        <Label Text="BEAT-DETECTION-PARAMETER"
                               Style="{StaticResource SectionHeaderLabelStyle}" />

                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="Modus" Style="{StaticResource FieldLabelStyle}" />
                                <Picker ItemsSource="{Binding BeatModeOptions}"
                                        SelectedItem="{Binding SelectedBeatModeOption, Mode=TwoWay}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Empfindlichkeit" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding BeatSensitivityText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="3">
                                <Label Text="MinFrameGap" Style="{StaticResource FieldLabelStyle}" />
                                <Entry Text="{Binding BeatMinFrameGapText, Mode=TwoWay}" Keyboard="Numeric" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="3">
                                <Label Text="Marker-Ziel" Style="{StaticResource FieldLabelStyle}" />
                                <Picker ItemsSource="{Binding MarkerTargetOptions}"
                                        SelectedItem="{Binding SelectedMarkerTargetOption, Mode=TwoWay}" />
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Switch IsToggled="{Binding BeatOnlyWorkArea, Mode=TwoWay}" />
                            <Label Text="Nur Arbeitsbereich analysieren (OnlyWorkArea)"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Save Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                StrokeShape="RoundRectangle 8"
                Padding="12,8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       IsVisible="{Binding HasStatusMessage}"
                       Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource StatusSuccess}"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding IsStatusError}"
                                     Value="True">
                            <Setter Property="TextColor" Value="{StaticResource StatusError}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Button Grid.Column="1"
                        Text="Einstellungen speichern"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Command="{Binding SaveSettingsCommand}" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
