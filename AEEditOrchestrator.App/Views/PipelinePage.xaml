<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AEEditOrchestrator.App.ViewModels"
             x:Class="AEEditOrchestrator.App.Views.PipelinePage"
             x:DataType="vm:PipelineViewModel"
             Title="Pipeline">

    <Grid RowDefinitions="Auto, *"
          Padding="14"
          RowSpacing="10">

        <!-- Compact Status Header -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                StrokeShape="RoundRectangle 6"
                Padding="12,9">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="Auto, *"
                      ColumnSpacing="12">

                    <!-- Connection Status -->
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="7"
                                           VerticalOptions="Center">
                        <Border WidthRequest="8"
                                HeightRequest="8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 4"
                                VerticalOptions="Center"
                                BackgroundColor="{StaticResource StatusNeutral}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAfterEffectsConnected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusSuccess}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                        <Label Text="{Binding ConnectionStatusText}"
                               FontSize="12"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsAfterEffectsConnected}"
                                             Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Active Project, Composition & Clip Count -->
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="8"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">
                        <Label Text="{Binding ProjectNameText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               ToolTipProperties.Text="{Binding ProjectFullPathText}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Label Text="·"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding CompositionNameText}"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />
                        <Label Text="·"
                               TextColor="{StaticResource TextMuted}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding ClipCountText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                        <Label IsVisible="{Binding IsProjectUnsavedWarning}"
                               Text="(Ungespeichert)"
                               FontSize="11"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource StatusWarning}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Optional Preflight Warning -->
                <Border IsVisible="{Binding HasPreflightWarning}"
                        BackgroundColor="{StaticResource StatusErrorBg}"
                        Stroke="{StaticResource StatusErrorBorder}"
                        StrokeShape="RoundRectangle 4"
                        Padding="8,4">
                    <Label Text="{Binding PreflightWarningText}"
                           FontSize="11"
                           TextColor="{StaticResource StatusError}"
                           LineBreakMode="TailTruncation" />
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Main Two-Column Content -->
        <Grid Grid.Row="1"
              ColumnDefinitions="1.06*, 0.94*"
              ColumnSpacing="12">

            <!-- Left Column: Step List + Quick Options -->
            <Grid Grid.Column="0"
                  RowDefinitions="*, Auto"
                  RowSpacing="10">

                <!-- Pipeline Steps Card -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 6"
                        Padding="12">
                    <Grid RowDefinitions="Auto, *"
                          RowSpacing="8">
                        <Label Grid.Row="0"
                               Text="PIPELINE-SCHRITTE"
                               Style="{StaticResource SectionHeaderLabelStyle}" />

                        <ScrollView Grid.Row="1">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}"
                                                 Spacing="5">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepItemViewModel">
                                        <Border BackgroundColor="{StaticResource SurfaceElevated}"
                                                Stroke="{StaticResource BorderSubtle}"
                                                StrokeShape="RoundRectangle 5"
                                                Padding="8,5">
                                            <Grid ColumnDefinitions="Auto, *, Auto"
                                                  ColumnSpacing="8">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsSelectionEnabled}"
                                                          VerticalOptions="Center" />

                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="1"
                                                                     VerticalOptions="Center"
                                                                     ToolTipProperties.Text="{Binding Description}">
                                                    <Label Text="{Binding DisplayName}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Description}"
                                                           Style="{StaticResource MutedCaptionLabelStyle}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1" />
                                                </VerticalStackLayout>

                                                <Border Grid.Column="2"
                                                        VerticalOptions="Center"
                                                        StrokeShape="RoundRectangle 4"
                                                        Padding="6,2"
                                                        BackgroundColor="{StaticResource SurfaceCard}"
                                                        Stroke="{StaticResource BorderSubtle}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding BadgeKind}"
                                                                     Value="Warning">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource StatusWarningBg}" />
                                                            <Setter Property="Stroke" Value="{StaticResource StatusWarningBorder}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding DependencyBadgeText}"
                                                           FontSize="10"
                                                           FontFamily="OpenSansRegular"
                                                           TextColor="{StaticResource TextSecondary}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding BadgeKind}"
                                                                         Value="TagBypass">
                                                                <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding BadgeKind}"
                                                                         Value="Warning">
                                                                <Setter Property="TextColor" Value="{StaticResource StatusWarning}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Border>

                <!-- Quick Options Card -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,10">
                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="0.88*, 0.92*, 1.2*"
                          RowSpacing="8"
                          ColumnSpacing="8">

                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                            <Label Text="Start-Richtung Stage 1"
                                   Style="{StaticResource FieldLabelStyle}"
                                   LineBreakMode="TailTruncation" />
                            <Picker ItemsSource="{Binding StartDirectionOptions}"
                                    SelectedItem="{Binding SelectedStartDirectionOption, Mode=TwoWay}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                            <Label Text="Zoom-Start Stage 2"
                                   Style="{StaticResource FieldLabelStyle}"
                                   LineBreakMode="TailTruncation" />
                            <Picker ItemsSource="{Binding BlurZoomStartOptions}"
                                    SelectedItem="{Binding SelectedBlurZoomStartOption, Mode=TwoWay}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="3">
                            <Label Text="Beat-Modus"
                                   Style="{StaticResource FieldLabelStyle}"
                                   LineBreakMode="TailTruncation" />
                            <Picker ItemsSource="{Binding BeatModeOptions}"
                                    SelectedItem="{Binding SelectedBeatModeOption, Mode=TwoWay}"
                                    IsEnabled="{Binding IsNotBusy}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding UseSelectedOnly, Mode=TwoWay}"
                                      IsEnabled="{Binding IsNotBusy}"
                                      VerticalOptions="Center" />
                            <Label Text="Nur markierte Clips verarbeiten"
                                   FontSize="12"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                    </Grid>
                </Border>

            </Grid>

            <!-- Right Column: Live Execution, Log & Actions -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto, *, Auto"
                  RowSpacing="10">

                <!-- Live Progress Card -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="STATUS"
                                   Style="{StaticResource SectionHeaderLabelStyle}" />
                            <Label Grid.Column="1"
                                   Text="{Binding ProgressPercentText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12.5"
                                   TextColor="{StaticResource TextPrimary}" />
                        </Grid>

                        <ProgressBar Progress="{Binding ProgressRatio}"
                                     HeightRequest="6" />

                        <Label Text="{Binding CurrentStepStatusText}"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="TailTruncation" />

                        <Label Text="{Binding CurrentBatchStatusText}"
                               Style="{StaticResource MutedCaptionLabelStyle}"
                               LineBreakMode="TailTruncation" />

                        <Border IsVisible="{Binding HasRollbackStatus}"
                                StrokeShape="RoundRectangle 4"
                                Padding="8,4"
                                BackgroundColor="{StaticResource StatusWarningBg}"
                                Stroke="{StaticResource StatusWarningBorder}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsRollbackError}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource StatusErrorBg}" />
                                    <Setter Property="Stroke" Value="{StaticResource StatusErrorBorder}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding RollbackStatusText}"
                                   FontSize="11"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource StatusWarning}"
                                   LineBreakMode="WordWrap">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsRollbackError}"
                                                 Value="True">
                                        <Setter Property="TextColor" Value="{StaticResource StatusError}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Live Log Card -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderStyle}"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,10">
                    <Grid RowDefinitions="Auto, *"
                          RowSpacing="6">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <Label Text="PROTOKOLL"
                                   Style="{StaticResource SectionHeaderLabelStyle}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Leeren"
                                    Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Padding="8,2"
                                    MinimumHeightRequest="24"
                                    FontSize="11" />
                        </Grid>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding LogEntries}"
                                        ItemsUpdatingScrollMode="KeepLastItemInView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineLogEntry">
                                    <Grid ColumnDefinitions="Auto, *"
                                          ColumnSpacing="8"
                                          Padding="2,2">
                                        <Label Grid.Column="0"
                                               Text="{Binding TimestampText}"
                                               FontSize="10.5"
                                               TextColor="{StaticResource TextMuted}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Message}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="WordWrap">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsError}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusError}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsSuccess}"
                                                             Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusSuccess}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="2"
                      RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *"
                      RowSpacing="8"
                      ColumnSpacing="8">
                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Text="Preflight prüfen"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Command="{Binding RunPreflightCommand}" />

                    <Button Grid.Row="0"
                            Grid.Column="1"
                            Text="Pipeline starten"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Command="{Binding StartPipelineCommand}" />

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Text="Abbrechen &amp; Rollback"
                            Style="{StaticResource DangerActionButtonStyle}"
                            Command="{Binding CancelAndRollbackCommand}" />
                </Grid>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>
