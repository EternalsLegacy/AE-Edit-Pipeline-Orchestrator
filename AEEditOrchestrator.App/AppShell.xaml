<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AEEditOrchestrator.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AEEditOrchestrator.App.Views"
    Title="AE Edit Pipeline Orchestrator"
    FlyoutBehavior="Locked"
    FlyoutWidth="196"
    FlyoutBackgroundColor="{StaticResource SurfaceCard}"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="16,18,16,10" Spacing="2">
            <Label Text="AE Edit"
                   FontFamily="OpenSansSemibold"
                   FontSize="15"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="Pipeline Orchestrator"
                   FontSize="11.5"
                   TextColor="{StaticResource TextSecondary}" />
            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderSubtle}"
                     Margin="0,12,0,2" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Border Margin="8,2"
                    Padding="12,0"
                    HeightRequest="36"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="Stroke" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
                                    <Setter Property="Stroke" Value="{StaticResource BorderStrong}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Label Text="{Binding Title}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12.5"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
            </Border>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Pipeline" Route="PipelineRoot">
        <ShellContent
            Title="Pipeline"
            ContentTemplate="{DataTemplate views:PipelinePage}"
            Route="PipelinePage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="SettingsRoot">
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Backups &amp; Recovery" Route="RecoveryRoot">
        <ShellContent
            Title="Backups &amp; Recovery"
            ContentTemplate="{DataTemplate views:RecoveryPage}"
            Route="RecoveryPage" />
    </FlyoutItem>

</Shell>
