<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AEEditOrchestrator.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AEEditOrchestrator.App.Views"
    Title="AE Edit Pipeline Orchestrator"
    FlyoutBehavior="Locked"
    FlyoutWidth="200"
    FlyoutBackgroundColor="{StaticResource SurfaceCard}"
    Shell.NavBarIsVisible="False">

    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="16,18,16,12" Spacing="4">
            <Label Text="AE EDIT"
                   FontFamily="OpenSansSemibold"
                   FontSize="16"
                   TextColor="{StaticResource TextPrimary}" />
            <Label Text="Pipeline Orchestrator"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}" />
            <Border BackgroundColor="{StaticResource AccentSubtleBg}"
                    Stroke="{StaticResource AccentSubtleBorder}"
                    StrokeShape="RoundRectangle 6"
                    Padding="8,3"
                    HorizontalOptions="Start"
                    Margin="0,6,0,0">
                <Label Text="AE 2026 · IPC"
                       FontSize="10.5"
                       FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource AccentHover}" />
            </Border>
            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderSubtle}"
                     Margin="0,10,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Border Margin="8,3"
                    Padding="12,0"
                    HeightRequest="38"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6"
                    BackgroundColor="Transparent"
                    Stroke="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                    <Setter Property="Stroke" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentSubtleBg}" />
                                    <Setter Property="Stroke" Value="{StaticResource AccentSubtleBorder}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Label Text="{Binding Title}"
                       FontFamily="OpenSansSemibold"
                       FontSize="12.5"
                       TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" />
            </Border>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Pipeline" Route="PipelineRoot">
        <ShellContent
            Title="Pipeline"
            ContentTemplate="{DataTemplate views:PipelinePage}"
            Route="PipelinePage" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="SettingsRoot">
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Backups &amp; Recovery" Route="RecoveryRoot">
        <ShellContent
            Title="Backups &amp; Recovery"
            ContentTemplate="{DataTemplate views:RecoveryPage}"
            Route="RecoveryPage" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16,12" Spacing="2">
            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderSubtle}"
                     Margin="0,0,0,8" />
            <Label Text="Snapshot-Transaktionen"
                   Style="{StaticResource MutedCaptionLabelStyle}" />
            <Label Text="Watchdog · ES3 ExtendScript"
                   Style="{StaticResource MutedCaptionLabelStyle}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
